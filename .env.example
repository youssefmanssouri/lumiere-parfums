# Database Configuration (Required - PostgreSQL / Neon)
# Neon connection string (use pooled connection for serverless):
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (Required)
JWT_SECRET="generate-a-strong-random-secret-here"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-to-a-secure-admin-password"

# Optional CRM Integration
CRM_URL=""
CRM_SYNC_TOKEN=""
